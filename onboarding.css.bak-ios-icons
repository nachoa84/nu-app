/* =========================================================
   V58 · Onboarding Native Clean
   Dos pasos · Presentación + Objetivo
   Sistema visual alineado con Nu App V52C.
   ========================================================= */

body.onboarding-open {
  overflow: hidden;
}

.onboarding-overlay,
.onboarding-overlay *,
.onboarding-overlay *::before,
.onboarding-overlay *::after {
  box-sizing: border-box;
}

.onboarding-overlay {
  position: fixed;
  inset: 0;
  z-index: 500;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: var(--app-bg);
  color: var(--app-text);
  font-family: inherit;
  -webkit-font-smoothing: antialiased;
}

.onboarding-overlay button,
.onboarding-overlay input {
  font: inherit;
  -webkit-tap-highlight-color: transparent;
}

.onboarding-panel {
  width: min(430px, 100%);
  height: 100dvh;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--app-bg);
}

.onboarding-topbar {
  flex: 0 0 auto;
  min-height: calc(58px + var(--safe-top));
  display: grid;
  grid-template-columns: 44px 1fr 44px;
  align-items: end;
  padding:
    calc(10px + var(--safe-top))
    18px
    8px;
  background: color-mix(in srgb, var(--app-bg) 92%, transparent);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.onboarding-brand {
  align-self: center;
  justify-self: center;
  color: var(--app-text);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.onboarding-back,
.onboarding-back-spacer {
  width: 40px;
  height: 40px;
}

.onboarding-back {
  display: grid;
  place-items: center;
  padding: 0;
  border: 1px solid var(--app-line);
  border-radius: 14px;
  background: var(--app-surface);
  color: var(--app-text);
  box-shadow: none;
}

.onboarding-back:active {
  transform: scale(.96);
}

.onboarding-back svg,
.onboarding-field-chevron svg,
.time-card-chevron svg {
  width: 19px;
  height: 19px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.onboarding-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding:
    12px
    20px
    calc(22px + var(--safe-bottom));
  scrollbar-width: none;
  overscroll-behavior: contain;
}

.onboarding-body::-webkit-scrollbar {
  display: none;
}

/* Progress */
.onboarding-progress {
  width: 100%;
  max-width: 360px;
  margin: 2px auto 28px;
}

.onboarding-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 9px;
  color: var(--app-muted);
  font-size: 12px;
}

.onboarding-progress-head span {
  font-weight: 600;
}

.onboarding-progress-head strong {
  color: var(--app-text);
  font-weight: 700;
}

.onboarding-progress-track {
  height: 3px;
  overflow: hidden;
  border-radius: 999px;
  background: var(--app-line);
}

.onboarding-progress-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--app-accent);
  transition: width .28s cubic-bezier(.32,.72,0,1);
}

.onboarding-progress-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 7px;
  color: #9aa1ac;
  font-size: 10.5px;
  font-weight: 600;
}

.onboarding-progress-labels .is-active {
  color: var(--app-accent-dark);
}

/* Steps */
.onboarding-step-content {
  width: 100%;
}

.onboarding-enter-left,
.onboarding-enter-right {
  animation: onboarding-step-in .22s cubic-bezier(.32,.72,0,1) both;
}

@keyframes onboarding-step-in {
  from {
    opacity: 0;
    transform: translateX(12px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.onboarding-step {
  width: 100%;
  min-height: calc(100dvh - 132px - var(--safe-top));
  display: flex;
  flex-direction: column;
}

.onboarding-heading {
  width: 100%;
  max-width: 360px;
  margin: 0 auto 24px;
}

.onboarding-eyebrow {
  display: block;
  margin-bottom: 7px;
  color: var(--app-accent-dark);
  font-size: 10.5px;
  font-weight: 750;
  letter-spacing: .09em;
}

.onboarding-heading h1 {
  max-width: 360px;
  margin: 0;
  color: var(--app-text);
  font-size: clamp(30px, 8.6vw, 37px);
  font-weight: 760;
  line-height: 1.04;
  letter-spacing: -.045em;
}

.onboarding-heading p {
  max-width: 350px;
  margin: 11px 0 0;
  color: var(--app-muted);
  font-size: 14px;
  line-height: 1.5;
}

/* Presentation */
.onboarding-fields {
  width: 100%;
  max-width: 360px;
  display: grid;
  gap: 11px;
  margin: 0 auto;
}

.onboarding-input-card {
  width: 100%;
  min-height: 66px;
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr);
  align-items: center;
  gap: 11px;
  padding: 10px 13px;
  border: 1px solid var(--app-line);
  border-radius: 18px;
  background: var(--app-surface);
  color: var(--app-text);
  box-shadow: none;
  text-align: left;
}

.onboarding-input-card:focus-within {
  border-color: color-mix(in srgb, var(--app-accent) 46%, var(--app-line));
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--app-accent) 9%, transparent);
}

.onboarding-select-card {
  grid-template-columns: 40px minmax(0, 1fr) 22px;
  cursor: pointer;
}

.onboarding-select-card:active,
.onboarding-time-card:active,
.objective-option:active {
  transform: scale(.985);
}

.onboarding-field-icon,
.time-card-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--app-accent-soft);
  color: var(--app-accent-dark);
}

.onboarding-field-icon svg,
.time-card-icon svg {
  width: 19px;
  height: 19px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.onboarding-input-copy {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.onboarding-input-copy small {
  color: var(--app-muted);
  font-size: 10.5px;
  font-weight: 650;
}

.onboarding-input-copy input {
  width: 100%;
  min-width: 0;
  height: 30px;
  padding: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--app-text);
  font-size: 16px;
  font-weight: 650;
}

.onboarding-input-copy input::placeholder,
.onboarding-input-copy strong.is-placeholder {
  color: #a2a9b4;
  opacity: 1;
}

.onboarding-input-copy strong {
  overflow: hidden;
  color: var(--app-text);
  font-size: 16px;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.onboarding-field-chevron,
.time-card-chevron {
  display: grid;
  place-items: center;
  color: #959daa;
}

/* Birth date: intentionally never persisted */
.onboarding-birth-block {
  padding: 14px;
  border: 1px solid var(--app-line);
  border-radius: 18px;
  background: var(--app-surface);
}

.onboarding-birth-head {
  margin-bottom: 11px;
}

.onboarding-birth-head small {
  display: block;
  margin-bottom: 2px;
  color: var(--app-muted);
  font-size: 10.5px;
  font-weight: 650;
}

.onboarding-birth-head strong {
  color: var(--app-text);
  font-size: 13px;
  font-weight: 700;
}

.onboarding-birth-inputs {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1.5fr;
  align-items: center;
  gap: 7px;
}

.onboarding-birth-inputs > span {
  color: #a8afba;
  font-size: 20px;
}

.birth-part {
  width: 100%;
  height: 46px;
  padding: 0 7px;
  border: 1px solid var(--app-line);
  border-radius: 13px;
  outline: 0;
  background: var(--app-bg);
  color: var(--app-text);
  font-size: 16px;
  font-weight: 700;
  text-align: center;
}

.birth-part:focus {
  border-color: color-mix(in srgb, var(--app-accent) 48%, var(--app-line));
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--app-accent) 8%, transparent);
}

.birth-part::placeholder {
  color: #aeb4be;
}

.onboarding-privacy-note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin: 10px 1px 0;
  color: var(--app-muted);
  font-size: 10.5px;
  line-height: 1.45;
}

.onboarding-privacy-note strong {
  color: var(--app-text);
  font-weight: 650;
}

.privacy-dot {
  width: 6px;
  height: 6px;
  flex: 0 0 auto;
  margin-top: 5px;
  border-radius: 50%;
  background: var(--app-success);
}

/* Objective */
.objective-options {
  width: 100%;
  max-width: 360px;
  display: grid;
  gap: 8px;
  margin: 0 auto;
}

.objective-option {
  width: 100%;
  min-height: 66px;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr);
  align-items: center;
  gap: 11px;
  padding: 11px 13px;
  border: 1px solid var(--app-line);
  border-radius: 17px;
  background: var(--app-surface);
  color: var(--app-text);
  text-align: left;
  box-shadow: none;
  transition:
    transform .12s cubic-bezier(.32,.72,0,1),
    border-color .12s ease,
    background .12s ease;
}

.objective-option.is-selected {
  border-color: color-mix(in srgb, var(--app-accent) 38%, var(--app-line));
  background: var(--app-accent-soft);
}

.objective-radio {
  width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  border: 1.5px solid #cdd3dc;
  border-radius: 50%;
  color: #fff;
}

.objective-option.is-selected .objective-radio {
  border-color: var(--app-accent);
  background: var(--app-accent);
}

.objective-radio svg {
  width: 14px;
  height: 14px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.objective-copy {
  min-width: 0;
  display: grid;
  gap: 2px;
}

.objective-copy strong {
  color: var(--app-text);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.25;
}

.objective-copy small {
  color: var(--app-muted);
  font-size: 10.5px;
  line-height: 1.35;
}

/* Time */
.onboarding-time-section {
  width: 100%;
  max-width: 360px;
  margin: 22px auto 0;
}

.onboarding-time-heading h2 {
  max-width: 330px;
  margin: 0 0 12px;
  color: var(--app-text);
  font-size: 18px;
  font-weight: 720;
  line-height: 1.22;
  letter-spacing: -.025em;
}

.onboarding-time-card {
  width: 100%;
  min-height: 72px;
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr) 22px;
  align-items: center;
  gap: 11px;
  padding: 11px 13px;
  border: 1px solid var(--app-line);
  border-radius: 18px;
  background: var(--app-surface);
  color: var(--app-text);
  text-align: left;
  box-shadow: none;
}

.time-card-copy {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.time-card-copy strong {
  color: var(--app-text);
  font-size: 25px;
  font-weight: 720;
  line-height: 1;
  letter-spacing: -.035em;
}

.time-card-copy small {
  overflow: hidden;
  color: var(--app-muted);
  font-size: 10.5px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.onboarding-time-help {
  margin: 8px 2px 0;
  color: var(--app-muted);
  font-size: 10.5px;
}

/* Error + CTA */
.onboarding-error {
  width: 100%;
  max-width: 360px;
  margin: 11px auto 0;
  padding: 10px 12px;
  border-radius: 13px;
  background: #fff1ee;
  color: #a54332;
  font-size: 11.5px;
  font-weight: 650;
  line-height: 1.4;
}

.onboarding-bottom-action {
  position: sticky;
  bottom: -1px;
  z-index: 6;
  width: 100%;
  max-width: 360px;
  margin: auto auto 0;
  padding: 20px 0 2px;
  background:
    linear-gradient(
      to bottom,
      color-mix(in srgb, var(--app-bg) 0%, transparent),
      color-mix(in srgb, var(--app-bg) 95%, transparent) 36%,
      var(--app-bg) 66%
    );
}

.onboarding-primary {
  width: 100%;
  min-height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 18px;
  border: 0;
  border-radius: 17px;
  background: var(--app-accent);
  color: #fff;
  font-size: 15px;
  font-weight: 720;
  box-shadow: none;
  transition:
    transform .12s cubic-bezier(.32,.72,0,1),
    opacity .12s ease;
}

.onboarding-primary:active:not(:disabled) {
  transform: scale(.975);
}

.onboarding-primary:disabled {
  opacity: .65;
}

.onboarding-primary svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Bottom sheets */
.onboarding-sheet-layer {
  position: fixed;
  inset: 0;
  z-index: 540;
  pointer-events: none;
}

.onboarding-sheet-backdrop {
  position: absolute;
  inset: 0;
  width: 100%;
  border: 0;
  background: rgba(17, 25, 43, 0);
  backdrop-filter: blur(0);
  -webkit-backdrop-filter: blur(0);
  transition:
    background .2s ease,
    backdrop-filter .2s ease;
}

.onboarding-sheet {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: min(430px, 100%);
  max-height: min(78dvh, 650px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding:
    8px
    18px
    calc(18px + var(--safe-bottom));
  border-radius: 28px 28px 0 0;
  background: var(--app-surface);
  color: var(--app-text);
  box-shadow: 0 -18px 48px rgba(22, 34, 61, .13);
  transform: translate(-50%, 105%);
  transition: transform .24s cubic-bezier(.32,.72,0,1);
}

.onboarding-sheet-layer.is-open {
  pointer-events: auto;
}

.onboarding-sheet-layer.is-open .onboarding-sheet-backdrop {
  background: rgba(17, 25, 43, .22);
  backdrop-filter: blur(7px) saturate(.92);
  -webkit-backdrop-filter: blur(7px) saturate(.92);
}

.onboarding-sheet-layer.is-open .onboarding-sheet {
  transform: translate(-50%, 0);
}

.sheet-grabber {
  width: 38px;
  height: 5px;
  flex: 0 0 auto;
  margin: 1px auto 14px;
  border-radius: 999px;
  background: #d7dce4;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  padding-bottom: 12px;
}

.sheet-header h2 {
  margin: 0;
  color: var(--app-text);
  font-size: 22px;
  font-weight: 740;
  letter-spacing: -.035em;
}

.sheet-close {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  padding: 0 0 2px;
  border: 0;
  border-radius: 50%;
  background: var(--app-surface-soft);
  color: var(--app-muted);
  font-size: 24px;
  line-height: 1;
}

.country-list {
  overflow-y: auto;
  padding: 2px 0 6px;
  overscroll-behavior: contain;
}

.country-option {
  width: 100%;
  min-height: 54px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 0 4px;
  border: 0;
  border-bottom: 1px solid var(--app-line);
  background: transparent;
  color: var(--app-text);
  font-size: 14px;
  font-weight: 620;
  text-align: left;
}

.country-option:last-child {
  border-bottom: 0;
}

.country-option.is-selected {
  color: var(--app-accent-dark);
  font-weight: 720;
}

.country-check {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  color: var(--app-accent);
}

.country-check svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.3;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Native-style custom time wheel */
.time-sheet {
  padding-bottom: calc(20px + var(--safe-bottom));
}

.time-sheet-header {
  justify-content: center;
  text-align: center;
}

.time-wheel-wrap {
  position: relative;
  width: min(290px, 90%);
  display: grid;
  grid-template-columns: 1fr 28px 1fr;
  align-items: center;
  margin: 6px auto 13px;
}

.time-wheel-highlight {
  position: absolute;
  left: 0;
  right: 0;
  top: 56px;
  height: 56px;
  pointer-events: none;
  border-top: 1px solid var(--app-line);
  border-bottom: 1px solid var(--app-line);
  border-radius: 15px;
  background: var(--app-accent-soft);
}

.time-wheel-column {
  position: relative;
  z-index: 1;
  min-width: 0;
  text-align: center;
}

.time-wheel {
  height: 168px;
  overflow-y: auto;
  padding-block: 56px;
  scrollbar-width: none;
  scroll-snap-type: y mandatory;
  overscroll-behavior: contain;
  mask-image: linear-gradient(to bottom, transparent, #000 31%, #000 69%, transparent);
  -webkit-mask-image: linear-gradient(to bottom, transparent, #000 31%, #000 69%, transparent);
}

.time-wheel::-webkit-scrollbar {
  display: none;
}

.time-wheel-item {
  width: 100%;
  height: 56px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 0;
  scroll-snap-align: center;
  background: transparent;
  color: #9ca4b0;
  font-size: 24px;
  font-weight: 620;
  line-height: 1;
  transition:
    color .12s ease,
    transform .12s ease,
    opacity .12s ease;
}

.time-wheel-item.is-selected {
  color: var(--app-text);
  font-size: 30px;
  font-weight: 750;
  transform: scale(1.03);
}

.time-wheel-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 3px;
  pointer-events: none;
  color: #a7aeba;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  opacity: 0;
}

.time-wheel-separator {
  position: relative;
  z-index: 2;
  display: grid;
  place-items: center;
  color: var(--app-text);
  font-size: 30px;
  font-weight: 750;
}

.time-sheet-note {
  max-width: 330px;
  margin: 4px auto 16px;
  color: var(--app-muted);
  font-size: 10.5px;
  line-height: 1.45;
  text-align: center;
}

.time-sheet-note strong {
  color: var(--app-text);
}

.sheet-confirm {
  margin-top: 0;
}

/* Finishing state */
.onboarding-preparing {
  width: min(430px, 100%);
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  padding:
    calc(28px + var(--safe-top))
    26px
    calc(28px + var(--safe-bottom));
  background: var(--app-bg);
  text-align: center;
}

.preparing-mark {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  margin-bottom: 18px;
  border-radius: 50%;
  background: var(--app-accent);
  color: #fff;
  animation: preparing-pop .38s cubic-bezier(.34,1.56,.64,1) both;
}

.preparing-mark svg {
  width: 29px;
  height: 29px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.onboarding-preparing h2 {
  margin: 0;
  color: var(--app-text);
  font-size: 28px;
  font-weight: 760;
  letter-spacing: -.045em;
}

.onboarding-preparing p {
  margin: 8px 0 0;
  color: var(--app-muted);
  font-size: 13px;
}

@keyframes preparing-pop {
  from {
    opacity: 0;
    transform: scale(.76);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Compact phones */
@media (max-width: 380px) {
  .onboarding-body {
    padding-left: 16px;
    padding-right: 16px;
  }

  .onboarding-heading h1 {
    font-size: 30px;
  }

  .objective-copy small {
    font-size: 10px;
  }
}

@media (max-height: 720px) {
  .onboarding-topbar {
    min-height: calc(52px + var(--safe-top));
    padding-top: calc(7px + var(--safe-top));
    padding-bottom: 5px;
  }

  .onboarding-body {
    padding-top: 7px;
  }

  .onboarding-progress {
    margin-bottom: 17px;
  }

  .onboarding-progress-labels {
    display: none;
  }

  .onboarding-heading {
    margin-bottom: 16px;
  }

  .onboarding-heading h1 {
    font-size: 29px;
  }

  .onboarding-heading p {
    margin-top: 7px;
    font-size: 12.5px;
  }

  .onboarding-fields {
    gap: 8px;
  }

  .onboarding-input-card {
    min-height: 59px;
  }

  .birth-part {
    height: 42px;
  }

  .objective-option {
    min-height: 58px;
    padding-top: 8px;
    padding-bottom: 8px;
  }

  .objective-copy small {
    display: none;
  }

  .onboarding-time-section {
    margin-top: 15px;
  }

  .onboarding-bottom-action {
    padding-top: 13px;
  }

  .onboarding-primary {
    min-height: 50px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .onboarding-progress-track span,
  .onboarding-step-content,
  .onboarding-sheet,
  .onboarding-sheet-backdrop,
  .objective-option,
  .onboarding-primary,
  .preparing-mark {
    animation: none !important;
    transition: none !important;
  }
}

/* =========================================================
   V88 · Cierre tipográfico del onboarding
   Ayudas y textos secundarios, sin cambios de lógica.
   ========================================================= */

.onboarding-progress-labels {
  font-size: 11.5px;
}

.onboarding-eyebrow {
  font-size: 11.5px;
}

.onboarding-input-copy small,
.onboarding-birth-head small {
  font-size: 12px;
  line-height: 1.35;
}

.onboarding-privacy-note {
  font-size: 12.5px;
  line-height: 1.5;
}

.objective-copy small {
  font-size: 12.5px;
  line-height: 1.4;
}

.time-card-copy small {
  font-size: 12.5px;
  line-height: 1.35;
}

.onboarding-time-help {
  font-size: 12.5px;
  line-height: 1.45;
}

.onboarding-error {
  font-size: 13px;
  line-height: 1.45;
}

.time-sheet-note {
  font-size: 12.5px;
  line-height: 1.5;
}

@media (max-height: 720px) {
  .onboarding-heading p {
    font-size: 13.5px;
    line-height: 1.45;
  }
}


/* Nu App · Installation Gate */
.install-gate-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  justify-content: center;
  overflow-y: auto;
  background: var(--surface, #fff);
}

.install-gate-panel {
  width: min(100%, 520px);
  min-height: 100%;
  padding: 28px 24px 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.install-gate-brand {
  position: absolute;
  top: 26px;
  left: 0;
  right: 0;
  text-align: center;
  font-weight: 700;
  font-size: 14px;
}

.install-gate-icon {
  width: 68px;
  height: 68px;
  margin: 28px auto 24px;
  display: grid;
  place-items: center;
  border-radius: 20px;
  background: var(--primary, #7657d6);
  color: #fff;
  font-size: 30px;
  font-weight: 800;
}

.install-gate-panel h1 {
  margin: 8px 0 14px;
  font-size: clamp(28px, 8vw, 38px);
  line-height: 1.08;
  text-align: center;
}

.install-gate-panel .onboarding-eyebrow {
  text-align: center;
}

.install-gate-lead {
  margin: 0 auto 28px;
  max-width: 420px;
  text-align: center;
  line-height: 1.65;
  color: var(--text-muted, #666);
}

.install-gate-hint {
  margin: 12px 0 0;
  text-align: center;
  font-size: 13px;
  color: var(--text-muted, #777);
}

.ios-install-guide {
  margin-top: 22px;
  padding: 18px;
  border-radius: 18px;
  background: rgba(120, 100, 180, 0.07);
}

.ios-install-step {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.ios-install-step + .ios-install-step {
  margin-top: 16px;
}

.ios-install-step > span {
  flex: 0 0 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--primary, #7657d6);
  color: #fff;
  font-size: 13px;
  font-weight: 700;
}

.ios-install-step p {
  margin: 3px 0 0;
  line-height: 1.5;
}


.install-gate-logo {
  display: block;
  width: min(220px, 68vw);
  height: auto;
  margin: 28px auto 30px;
  object-fit: contain;
}
